# Whitelist: the code used to produce and QA the v3 dataset (JEWEL 2.6.0 hepmc + Fun4All two-pass).
# Slides and build products are left out.
/*
!/.gitignore
!/README.md
!/jewel/
!/fun4all/
!/qa/

# jewel: generated/downloaded by install.sh and scripts/make_tables.sh
/jewel/src/
/jewel/bin/
/jewel/pdfsets/
/jewel/configs/*/tables/

# fun4all: build products (install.sh)
/fun4all/build/
/fun4all/install/
/fun4all/src/jeweltreewriter/autom4te.cache/
/fun4all/src/jeweltreewriter/aclocal.m4
/fun4all/src/jeweltreewriter/configure
/fun4all/src/jeweltreewriter/Makefile.in

# QA outputs and binaries
/qa/jewel/jetqa
/qa/v3_plots/data/
/qa/genesis/*/
*.root
*.png
*.pdf

# ROOT ACLiC products
*_C.d
*_C.so
*_ACLiC_dict_rdict.pcm
# autotools helper symlinks created by autogen.sh
/fun4all/src/jeweltreewriter/compile
/fun4all/src/jeweltreewriter/config.guess
/fun4all/src/jeweltreewriter/config.sub
/fun4all/src/jeweltreewriter/depcomp
/fun4all/src/jeweltreewriter/install-sh
/fun4all/src/jeweltreewriter/ltmain.sh
/fun4all/src/jeweltreewriter/missing
